---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | EC Consultoria" description="A página que você procurou não existe ou mudou de endereço.">
  <div class="page-hero" style="border-bottom:0">
    <div class="wrap">
      <span class="eyebrow">Erro 404</span>
      <h1>Esta página não fecha a conta.</h1>
      <p class="lede">O endereço não existe ou mudou. Volte para o início ou fale com a gente.</p>
      <div class="cta-row" style="margin-top:24px">
        <a class="btn btn-primary" href="/">Ir para o início</a>
        <a class="btn btn-ghost" href="/contato">Contato</a>
      </div>
    </div>
  </div>
</Base>
