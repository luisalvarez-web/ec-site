---
import Base from '../layouts/Base.astro';
import ContactCard from '../components/ContactCard.astro';
import { site } from '../data/site';
---
<Base
  title="Contato | EC Consultoria, Contabilidade em Vitória/ES"
  description="Fale com a EC Consultoria pelo telefone e WhatsApp (27) 3191-4636 ou por e-mail. Av. N. Sra. dos Navegantes, 451, Enseada do Suá, Vitória/ES."
>
  <section class="block">
    <div class="wrap">
      <ContactCard as="h1" heading="Vamos conversar sobre a sua empresa." />
    </div>
  </section>

  <section class="block tight">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Já é cliente?</span>
          <h2>Seus documentos e relatórios, sempre à mão.</h2>
        </div>
        <p>Entre com o usuário criado pela nossa equipe. Se precisar de acesso, chame no WhatsApp.</p>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary" href={site.portal} target="_blank" rel="noopener">Entrar no Portal EC</a>
        <a class="btn btn-ghost" href={site.onvio} target="_blank" rel="noopener">Entrar no Onvio</a>
      </div>
    </div>
  </section>
</Base>
