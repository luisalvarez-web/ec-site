---
import Base from '../layouts/Base.astro';
import ContactCard from '../components/ContactCard.astro';
import { faq } from '../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  title="Perguntas Frequentes (FAQ) | EC Consultoria Contabilidade"
  description="Dúvidas sobre troca de contador, Portal EC, regimes tributários, IRPF, Reforma Tributária e honorários? Veja as respostas da EC Consultoria."
  schema={schema}
>
  <div class="page-hero">
    <div class="wrap">
      <span class="eyebrow">FAQ</span>
      <h1>Perguntas frequentes.</h1>
      <p class="lede">As dúvidas que mais ouvimos de quem está abrindo uma empresa, trocando de contador ou fazendo o imposto de renda.</p>
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="faq">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <ContactCard heading="Não encontrou sua dúvida?" />
    </div>
  </section>
</Base>
