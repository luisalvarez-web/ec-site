---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import { guias, type Guia } from '../../data/guias';
import { site } from '../../data/site';

export function getStaticPaths() {
  return guias.map((guia) => ({ params: { slug: guia.slug }, props: { guia } }));
}

const { guia } = Astro.props as { guia: Guia };

// Print do passo, se existir em public/guias/<slug>/passo-<n>.(png|jpg|webp).
const imgDir = join(process.cwd(), 'public', 'guias', guia.slug);
const printDo = (n: number) => {
  for (const ext of ['webp', 'png', 'jpg', 'jpeg']) {
    if (existsSync(join(imgDir, `passo-${n}.${ext}`))) return `/guias/${guia.slug}/passo-${n}.${ext}`;
  }
  return undefined;
};

const [ano, mes, dia] = guia.revisado.split('-');
const revisado = `${dia}/${mes}/${ano}`;
const whatsapp = `${site.whatsapp.href}?text=${encodeURIComponent(`Olá! Estou no guia "${guia.title}" e fiquei com uma dúvida.`)}`;
---
<Base title={guia.seoTitle} description={guia.description}>
  <div class="page-hero">
    <div class="wrap">
      <a class="guia-back" href="/guias">← Todos os guias</a>
      <span class="eyebrow">Passo a passo · {guia.tag}</span>
      <h1>{guia.title}</h1>
      <p class="lede">{guia.lede}</p>
      <ul class="guia-meta">
        <li>{guia.steps.length} passos</li>
        <li>{guia.tempo}</li>
        <li>revisado em {revisado}</li>
      </ul>
      <div class="cta-row guia-actions">
        <button type="button" class="btn btn-ghost btn-sm" data-share>Copiar link</button>
        <button type="button" class="btn btn-ghost btn-sm" data-print>Imprimir ou salvar PDF</button>
      </div>
    </div>
  </div>

  <section class="block">
    <div class="wrap guia">
      <aside class="guia-before">
        <h2>Antes de começar</h2>
        <ul class="ticks">
          {guia.before.map((item) => <li set:html={item} />)}
        </ul>
      </aside>

      <ol class="guia-steps">
        {guia.steps.map((step, i) => {
          const img = printDo(i + 1);
          return (
            <li class="guia-step" id={`passo-${i + 1}`}>
              <span class="guia-n" aria-hidden="true">{i + 1}</span>
              <div class="guia-body">
                <h3>{step.title}</h3>
                <p set:html={step.text} />
                {step.copy && (
                  <div class="guia-copy">
                    <span>{step.copy.label}</span>
                    <code>{step.copy.value}</code>
                    <button type="button" class="btn btn-primary btn-sm" data-copy={step.copy.value}>Copiar</button>
                  </div>
                )}
                {step.note && <p class="guia-note" set:html={step.note} />}
                {img && (
                  <a class="guia-img" href={img} target="_blank" rel="noopener">
                    <img src={img} alt={step.alt ?? step.title} loading="lazy" decoding="async" />
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ol>

      {guia.extra && (
        <div class="guia-extra">
          <h2>{guia.extra.title}</h2>
          <p set:html={guia.extra.text} />
        </div>
      )}

      <div class="guia-help">
        <div>
          <h2>Travou em algum passo?</h2>
          <p>Chame a gente no WhatsApp e diga em qual passo parou. A gente ajuda na hora.</p>
        </div>
        <a class="btn btn-primary" href={whatsapp} target="_blank" rel="noopener">Falar no WhatsApp</a>
      </div>

      <p class="guia-fonte">
        Fonte oficial: <a href={guia.fonte.href} target="_blank" rel="noopener">{guia.fonte.label}</a>.
        As telas dos sites do governo mudam com frequência; se algo estiver diferente, avise a gente.
      </p>
    </div>
  </section>

  <script>
    const flash = (btn: HTMLButtonElement, text: string) => {
      const original = btn.textContent;
      btn.textContent = text;
      setTimeout(() => (btn.textContent = original), 1800);
    };
    const copiar = async (value: string) => {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        return false;
      }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
      btn.addEventListener('click', async () => flash(btn, (await copiar(btn.dataset.copy!)) ? 'Copiado ✓' : 'Copie manualmente')),
    );
    document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => window.print());
    document.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const url = location.origin + location.pathname;
      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        try {
          await navigator.share({ title: document.title, url });
          return;
        } catch {
          /* cancelado: cai na cópia */
        }
      }
      flash(btn, (await copiar(url)) ? 'Link copiado ✓' : url);
    });
  </script>
</Base>
